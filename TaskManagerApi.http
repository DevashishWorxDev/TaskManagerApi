@TaskManagerApi_HostAddress = http://localhost:5156

GET {{TaskManagerApi_HostAddress}}/api/tasks
Accept: application/json

###

# Filter by completion status and/or priority (Low, Medium, High)
GET {{TaskManagerApi_HostAddress}}/api/tasks?isCompleted=false&priority=High
Accept: application/json

###

GET {{TaskManagerApi_HostAddress}}/api/tasks/1
Accept: application/json

###

POST {{TaskManagerApi_HostAddress}}/api/tasks
Content-Type: application/json

{
  "title": "Resolve a merge conflict",
  "description": "Edit the same line on two branches",
  "priority": "High"
}

###

# Fails validation: title is required
POST {{TaskManagerApi_HostAddress}}/api/tasks
Content-Type: application/json

{
  "title": ""
}

###

PUT {{TaskManagerApi_HostAddress}}/api/tasks/1
Content-Type: application/json

{
  "title": "Learn git basics",
  "description": "init, add, commit, log",
  "isCompleted": true,
  "priority": "Low"
}

###

PATCH {{TaskManagerApi_HostAddress}}/api/tasks/2/complete

###

DELETE {{TaskManagerApi_HostAddress}}/api/tasks/2

###
